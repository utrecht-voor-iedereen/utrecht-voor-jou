{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "BeneficiosCatalog",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "id",
      "category",
      "type",
      "wijk",
      "verificationStatus",
      "lastReviewed",
      "expiresSoon",
      "officialUrl",
      "profiles",
      "title",
      "shortDescription",
      "eligibility",
      "howToApply"
    ],
    "properties": {
      "id": {
        "type": "integer",
        "minimum": 1
      },
      "category": {
        "type": "string",
        "enum": [
          "verde",
          "dinero",
          "energia",
          "legal",
          "cultura",
          "movilidad",
          "comunidad",
          "vida"
        ]
      },
      "type": {
        "type": "string",
        "enum": ["gratis", "subsidio", "préstamo", "servicio"]
      },
      "wijk": {
        "type": "string",
        "enum": [
          "all",
          "Binnenstad",
          "Oost",
          "West",
          "Noordwest",
          "Overvecht",
          "Zuid",
          "Zuidwest",
          "Leidsche Rijn",
          "Vleuten-De Meern",
          "Noordoost"
        ]
      },
      "verificationStatus": {
        "type": "string",
        "enum": ["verificado", "por-verificar"]
      },
      "lastReviewed": {
        "type": "string",
        "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
      },
      "expiresSoon": {
        "type": "boolean"
      },
      "expiryDate": {
        "type": "string"
      },
      "officialUrl": {
        "type": "string",
        "format": "uri"
      },
      "profiles": {
        "type": "array",
        "items": {
          "type": "string",
          "enum": [
            "iedereen",
            "gezin",
            "student",
            "senior",
            "ondernemer",
            "lage-inkomens",
            "huurder",
            "huiseienaar"
          ]
        }
      },
      "title": {
        "type": "object",
        "required": ["nl", "en", "es"]
      },
      "shortDescription": {
        "type": "object",
        "required": ["nl", "en", "es"]
      },
      "eligibility": {
        "type": "object",
        "required": ["nl", "en", "es"]
      },
      "howToApply": {
        "type": "object",
        "required": ["nl", "en", "es"]
      }
    }
  }
}
